{
    "root": false,
    "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
    "extends": [
        "../../biome.json"
    ],
    "linter": {
        "rules": {
            "style": {
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "paths": {
                            "@/*": "Packages must not import from the app alias (@/…).",
                            "@sphere/ui": "@sphere/draw must not depend on @sphere/ui.",
                            "@tauri-apps/api": "@sphere/draw must not depend on Tauri.",
                            "@reduxjs/toolkit": "@sphere/draw must not depend on Redux.",
                            "react-redux": "@sphere/draw must not depend on Redux.",
                            "react": "@sphere/draw must not depend on React."
                        }
                    }
                }
            }
        }
    },
    "files": {
        "includes": [
            "**/src/**/*.ts"
        ]
    }
}
